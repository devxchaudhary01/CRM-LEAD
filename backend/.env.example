# ── Server ──────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB ─────────────────────────────────
MONGO_URI=mongodb://localhost:27017/crm_v3

# ── JWT ─────────────────────────────────────
JWT_SECRET=your_super_long_jwt_secret_change_this
JWT_EXPIRE=7d

# ── Session (for Google OAuth callback) ─────
SESSION_SECRET=your_session_secret_change_this

# ── Google OAuth ─────────────────────────────
# Get from: console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ── Frontend URL (for redirect after Google login) ──
FRONTEND_URL=http://localhost:3000

# ── Razorpay ─────────────────────────────────
# Get from: dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ── Plan Prices (in paise: ₹999 = 99900) ────
PRICE_BASIC=99900
PRICE_PRO=299900
